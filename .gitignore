# Build artifacts inside examples/ and poc/ — the source files (.tscn,
# .gdextension, project.godot) are committed; built shared libraries
# and Godot cache are not.
**/graphics/.godot/
**/graphics/*.dll
**/graphics/*.so
**/graphics/*.dylib
**/graphics/~*
examples/*/*.exe
poc/*/*.exe
